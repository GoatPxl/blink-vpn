{
  "name": "2vpsn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern src-tauri/target/**",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/*.test.mts\"",
    "tauri:e2e:docker:real": "playwright test --config=playwright.tauri.config.ts --project=tauri-real",
    "backend:test:docker:real": "cargo test --manifest-path src-tauri/Cargo.toml real_docker -- --ignored --nocapture",
    "backend:test:docker:clientconf": "cargo test --manifest-path src-tauri/Cargo.toml real_docker_emits_connectable_client_config -- --ignored --nocapture",
    "docker:cleanup": "node scripts/docker-cleanup.mjs",
    "tauri:dev": "tauri dev",
    "tauri:dev:e2e": "tauri dev --no-watch",
    "tauri:build": "tauri build",
    "tauri:e2e:provisioning": "playwright test --config=playwright.tauri.config.ts --project=tauri-real tests/e2e/dashboard-provisioning-tauri.spec.ts",
    "tauri:e2e:connect": "node scripts/e2e-preflight.mjs --connect && playwright test --config=playwright.tauri.config.ts --project=tauri-real tests/e2e/dashboard-connect-tauri.spec.ts",
    "e2e:preflight": "node scripts/e2e-preflight.mjs",
    "backend:test:do:real": "cargo test --manifest-path src-tauri/Cargo.toml real_digitalocean -- --ignored --nocapture",
    "backend:test:ec2:real": "cargo test --manifest-path src-tauri/Cargo.toml real_ec2 -- --ignored --nocapture",
    "backend:test:linode:real": "cargo test --manifest-path src-tauri/Cargo.toml real_linode -- --ignored --nocapture"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
