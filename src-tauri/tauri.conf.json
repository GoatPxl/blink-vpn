{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GoatStare VPN",
  "version": "0.1.0",
  "identifier": "com.goatstare.vpn",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GoatStare VPN",
        "width": 1360,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources-windows/": "resources-windows/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer.nsi"
      }
    }
  }
}
